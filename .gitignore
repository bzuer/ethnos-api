# Logs and runtime artifacts
logs/
!logs/.gitkeep
runtime/
*.log
*.log.*
docs/

# Test coverage
coverage/

# Python virtual envs
venv/

# Backups and large binary artifacts
backup/
!backup/README.md

# Local environment files (keep examples only)
.env
.env*
*.env*

# Database dumps
database/*.sql
!database/schema.sql
!database/data.schema.sql
!database/README.md

# SSL certificates and artifacts
ssl/*.pem
ssl/*.key
ssl/*.srl
ssl/*.cnf
ssl/*.crt

# Deploy scripts
rsync.sh
init.sh

# Node-related
node_modules/
*.tgz

# OS/editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Agents config
.claude/
.text/
