# Logs and runtime artifacts
logs/
!logs/.gitkeep
runtime/
*.log
*.log.*
docs/

# Test coverage
coverage/

# Python virtual envs
venv/

# Backups and large binary artifacts
backup/
!backup/README.md

# Local environment files (keep examples only)
.env
.env*
*.env*

# Database: schema snapshots are tracked under backups/ (dated, via
# scripts/maintenance/publications/regenerate_schema_dump.sh). database/ holds
# only the operator-side DDL contract.
database/*.sql
!database/required_objects.sql

# SSL certificates and artifacts
ssl/*.pem
ssl/*.key
ssl/*.srl
ssl/*.cnf
ssl/*.crt

# Deploy scripts
rsync.sh
init.sh

# Node-related
node_modules/
*.tgz

# OS/editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Agents config
.claude/
.text/
