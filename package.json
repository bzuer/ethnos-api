{
  "name": "ethnos-api",
  "description": "Academic bibliographic system API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "build": "bash scripts/process.sh build",
    "deploy": "bash scripts/process.sh deploy",
    "dev": "bash scripts/process.sh dev",
    "dev:server": "node --watch src/app.js",
    "test": "cross-env NODE_ENV=test TEST_FAST=1 node --test --test-concurrency=1 -r ./tests/bootstrap.js ./tests/api.endpoints.test.js",
    "test:watch": "cross-env NODE_ENV=test TEST_FAST=1 node --test --watch --test-concurrency=1 -r ./tests/bootstrap.js ./tests/api.endpoints.test.js",
    "test:coverage": "cross-env NODE_ENV=test TEST_FAST=1 node --test --experimental-test-coverage --test-concurrency=1 -r ./tests/bootstrap.js ./tests/api.endpoints.test.js",
    "test:integration": "node --test ./tests/integration.smoke.test.js",
    "test:load": "echo 'Load testing with artillery removed due to security vulnerabilities. Consider using autocannon or wrk for load testing.'",
    "docs:generate": "node scripts/generate-swagger.js",
    "docs:generate:yaml": "node scripts/generate-swagger.js --yaml-only"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.3.2",
    "glob": "^13.0.6",
    "helmet": "^8.2.0",
    "helmet-csp": "^4.0.0",
    "joi": "^18.2.3",
    "mariadb": "^3.5.3",
    "morgan": "^1.11.0",
    "mysql2": "^3.22.5",
    "redis": "^6.0.1",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "keywords": [
    "ethnos",
    "api",
    "bibliography",
    "academic",
    "mariadb",
    "express"
  ],
  "overrides": {
    "swagger-jsdoc": {
      "glob": "^11.0.3"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true
  }
}
