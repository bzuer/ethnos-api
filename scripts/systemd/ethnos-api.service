[Unit]
Description=Ethnos API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/api
EnvironmentFile=/etc/node-backend.env
ExecStart=/home/ubuntu/.nvm/versions/node/v24.14.0/bin/node /home/ubuntu/api/src/app.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
