[Unit]
Description=Ethnos API
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__WORKDIR__
EnvironmentFile=/etc/node-backend.env
ExecStart=__NODE_BIN__ __WORKDIR__/src/app.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethnos-api

[Install]
WantedBy=multi-user.target
