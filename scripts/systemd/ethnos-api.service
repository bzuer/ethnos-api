[Unit]
Description=Ethnos API
After=network.target

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
EnvironmentFile=/etc/node-backend.env
ExecStart=__NODE_BIN__ __WORKDIR__/src/app.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethnos-api

[Install]
WantedBy=default.target
